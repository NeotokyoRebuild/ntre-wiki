#!/usr/bin/env bash
# Publish the wiki to https://neotokyorebuild.github.io/ntre-wiki/, and manage the versions on
# the gh-pages branch of NeotokyoRebuild/ntre-wiki. The 🚀 Deploy workflow runs the first two.
#
#   ./deploy [minor] [TITLE]        deploy the next minor version after latest: 0.3 -> 0.4
#   ./deploy major [TITLE]          deploy the next major version after latest: 0.4 -> 1.0
#   ./deploy M.m [TITLE]            deploy that exact version, replacing it if it exists
#   ./deploy rollback VERSION       point `latest` at a deployed version, without a build
#   ./deploy list                   list the deployed versions
#   ./deploy delete VERSION...      delete versions from the site, after asking
#   ./deploy --dry-run ...          a deploy, rollback or delete, without the push
#
# minor and major count from the version `latest` points at (the first deploy is 0.1, or
# 1.0 for major), and skip versions that already exist by applying the same step again:
# with latest at 0.1 and 0.2 deployed, the next minor is 0.3. An exact version must be
# M.m: two whole numbers without leading zeros, such as 0.4 or 1.10.
#
# A deploy only runs from a clean tree whose HEAD is on main in NeotokyoRebuild/ntre-wiki, and
# only after ./check passes. A new version identical to what `latest` serves is not
# deployed. The ⏪ Rollback workflow runs rollback. Delete never touches
# the version `latest` points at. The published address is set here and nowhere else
# (override with NTRE_WIKI_URL).
set -euo pipefail
cd "$(dirname "$0")"

DRY_RUN=0
if [[ ${1:-} == --dry-run ]]; then DRY_RUN=1; shift; fi

REPO_SLUG=NeotokyoRebuild/ntre-wiki
BRANCH=gh-pages
export NTRE_WIKI_URL=${NTRE_WIKI_URL:-https://neotokyorebuild.github.io/ntre-wiki/}
export NO_MKDOCS_2_WARNING=1

say() { printf '\033[1m==> %s\033[0m\n' "$*"; }
die() { printf '\033[31merror:\033[0m %s\n' "$*" >&2; exit 1; }

[[ -x wiki/.venv/bin/mike ]] || die "no Python environment yet: run ./setup"
export PATH="$PWD/wiki/.venv/bin:$PATH"

# The remote for NeotokyoRebuild/ntre-wiki, found by URL: origin in CI, often upstream locally.
find_remote() {
  REMOTE=
  for r in $(git remote); do
    if [[ $(git remote get-url --push "$r") =~ github\.com[:/]$REPO_SLUG(\.git)?$ ]]; then REMOTE=$r; return; fi
  done
  die "no remote for github.com/$REPO_SLUG: git remote add upstream git@github.com:$REPO_SLUG.git"
}

# Bring the local gh-pages up to date; fails rather than overwrite a local branch that
# differs. Sets BASE (the remote tip, empty before the first deploy) and RESET (how to
# undo a local commit on top of it).
fetch_pages() {
  say "Fetching $REMOTE/$BRANCH"
  if git ls-remote --exit-code --heads "$REMOTE" "$BRANCH" >/dev/null; then
    git fetch -q "$REMOTE" "$BRANCH:$BRANCH" \
      || die "local $BRANCH isn't behind $REMOTE/$BRANCH: delete it (git branch -D $BRANCH) and run again"
    BASE=$(git rev-parse "$BRANCH")
    RESET="git branch -f $BRANCH $BASE"
  else
    ! git rev-parse -q --verify "refs/heads/$BRANCH" >/dev/null \
      || die "$REMOTE has no $BRANCH yet, but a local one exists: delete it (git branch -D $BRANCH) so the first deploy starts empty"
    BASE=
    RESET="git branch -D $BRANCH"
  fi
}

versions_json() { if [[ -n $BASE ]]; then git show "$BRANCH:versions.json"; else echo '[]'; fi; }

# A version is M.m: two whole numbers without leading zeros (0.4, 1.10; not 01.2 or 1.2.3).
is_version() { [[ $1 =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; }

# A regex matching any of the given versions exactly, as a path segment: 0.1 -> 0\.1
versions_re() { local out= v; for v in "$@"; do out+=${out:+|}${v//./\\.}; done; printf '%s' "$out"; }

# Guard rails for the local commit: no symlinks (GitHub Pages rejects them), a fast-forward
# of the remote, and every changed path matching $1.
check_result() {
  say "Checking the result"
  local links outside
  links=$(git ls-tree -r "$BRANCH" | awk '$1 == "120000" {print $4}')
  [[ -z $links ]] || die "symlinks on $BRANCH, which GitHub Pages rejects: $links (undo with: $RESET)"
  [[ -n $BASE ]] || return 0
  git merge-base --is-ancestor "$BASE" "$BRANCH" || die "$BRANCH isn't a fast-forward of $REMOTE/$BRANCH (undo with: $RESET)"
  outside=$(git diff --name-only "$BASE" "$BRANCH" | grep -v -E "$1" || true)
  [[ -z $outside ]] || die "$2: $outside (undo with: $RESET)"
}

# Push the local commit and wait for GitHub Pages to publish it.
publish() {
  if (( DRY_RUN )); then
    say "Dry run: not pushing. To discard the local commit: $RESET"
    exit 0
  fi
  say "Pushing to $REMOTE"
  git push -q "$REMOTE" "$BRANCH"
  if command -v gh >/dev/null && gh auth status >/dev/null 2>&1; then
    gh api "repos/$REPO_SLUG/pages" >/dev/null 2>&1 \
      || die "pushed, but GitHub Pages isn't set up for $REPO_SLUG: in Settings → Pages, deploy from the $BRANCH branch, / (root)"
    local deployed id state
    deployed=$(git rev-parse "$BRANCH")
    say "Waiting for GitHub Pages"
    for _ in $(seq 1 30); do
      id=$(gh api "repos/$REPO_SLUG/deployments?sha=$deployed&per_page=1" --jq '.[0].id // empty' 2>/dev/null || true)
      state=${id:+$(gh api "repos/$REPO_SLUG/deployments/$id/statuses" --jq '.[0].state // empty' 2>/dev/null || true)}
      case $state in
        success) return 0 ;;
        failure|error) die "GitHub Pages deploy $state: https://github.com/$REPO_SLUG/deployments" ;;
      esac
      sleep 10
    done
    die "timed out waiting for GitHub Pages: https://github.com/$REPO_SLUG/deployments"
  fi
}

# ./deploy [minor|major|M.m] [TITLE]
deploy_version() {
  local sha kind version title
  kind=${1:-minor}
  case $kind in
    minor|major) ;;
    *) is_version "$kind" || die "not a version: $kind (use minor, major, or M.m, such as 0.4)" ;;
  esac

  say "Checking the source"
  [[ -z $(git status --porcelain) ]] || die "uncommitted changes: commit and merge them first"
  git fetch -q "$REMOTE" main
  git merge-base --is-ancestor HEAD FETCH_HEAD || die "HEAD $(git rev-parse --short HEAD) isn't on $REMOTE/main"
  sha=$(git rev-parse --short HEAD)
  ./check
  fetch_pages

  version=$(versions_json | python3 -c '
import json, sys
kind = sys.argv[1]
if kind not in ("minor", "major"):
    print(kind)
    sys.exit()
deployed, latest = set(), None
for v in json.load(sys.stdin):
    try:
        number = tuple(int(n) for n in v["version"].split("."))
    except ValueError:
        continue
    deployed.add(number)
    if "latest" in v["aliases"]:
        latest = number
step = (lambda m, n: (m, n + 1)) if kind == "minor" else (lambda m, n: (m + 1, 0))
target = step(*(latest or max(deployed, default=(0, 0))))
while target in deployed:
    target = step(*target)
print("%d.%d" % target)' "$kind")
  title=${2:-$version}

  say "Deploying $version ($title) from $sha to $BRANCH"
  (
    cd wiki
    mike deploy --remote "$REMOTE" --branch "$BRANCH" --update-aliases --title "$title" \
      -m "Deploy the wiki $version from $sha" "$version" latest
  )
  # A new version identical to what latest/ already serves would only add a duplicate to
  # the version menu: stop instead, and discard the local commit. The sitemaps don't
  # count: they carry the build date.
  if [[ $kind == minor || $kind == major ]] && [[ -n $BASE ]] \
     && git rev-parse -q --verify "$BASE:latest" >/dev/null \
     && git diff --quiet "$BASE:latest" "$BRANCH:$version" -- . ':(exclude)sitemap.xml' ':(exclude)sitemap.xml.gz'; then
    git branch -f "$BRANCH" "$BASE"
    local current
    current=$(versions_json | python3 -c 'import json, sys; print(next((v["version"] for v in json.load(sys.stdin) if "latest" in v["aliases"]), "latest"))')
    [[ -z ${GITHUB_ACTIONS:-} ]] || echo "::notice title=Nothing to deploy::The site built from $sha is identical to $current, which latest already serves."
    say "Nothing to deploy: the site built from $sha is identical to $current, which latest already serves"
    return 0
  fi
  (
    cd wiki
    mike set-default --remote "$REMOTE" --branch "$BRANCH" --template redirect.html \
      -m "Point the wiki at $version" latest
  )
  check_result "^($(versions_re "$version")|latest)/|^(versions\.json|index\.html|\.nojekyll)$" \
    "the deploy changed files outside $version/ and latest/"
  publish
  say "Published ${NTRE_WIKI_URL}latest/ ($version from $sha)"
}

# ./deploy rollback VERSION: moves `latest` (a copy of a version's folder) to another
# deployed version. Nothing is built, and main isn't touched: the next deploy publishes
# main again.
rollback_to() {
  [[ $# -eq 1 ]] || die "name one version to roll back to, e.g. ./deploy rollback 0.2 (./deploy list shows them)"
  local target=$1 current
  is_version "$target" || die "not a version: $target (use M.m, such as 0.2)"
  fetch_pages
  [[ -n $BASE ]] || die "nothing is deployed yet"
  current=$(versions_json | python3 -c '
import json, sys
target = sys.argv[1]
versions = json.load(sys.stdin)
current = next((v["version"] for v in versions if "latest" in v["aliases"]), "")
if target not in [v["version"] for v in versions]:
    sys.exit("error: " + target + " is not a deployed version (./deploy list shows them)")
if target == current:
    sys.exit("error: latest already points at " + target)
print(current)' "$target")

  say "Moving latest from ${current:-nothing} to $target"
  (
    cd wiki
    mike alias --remote "$REMOTE" --branch "$BRANCH" --update-aliases \
      -m "Roll the wiki back to $target (latest was ${current:-unset})" "$target" latest
  )
  check_result "^latest/|^versions\.json$" "the rollback changed files outside latest/"
  publish
  say "Published ${NTRE_WIKI_URL}latest/ ($target)"
}

# ./deploy list: each version with its aliases, and when and from which commit it was
# deployed (read from mike's commit messages).
list_versions() {
  fetch_pages
  [[ -n $BASE ]] || { echo "Nothing is deployed yet."; return 0; }
  versions_json | python3 -c '
import json, re, subprocess, sys
log = subprocess.run(["git", "log", "--format=%cs %s", sys.argv[1]], capture_output=True, text=True, check=True).stdout
deployed = {}
for line in log.splitlines():
    date, _, subject = line.partition(" ")
    m = re.fullmatch(r"Deploy the wiki (\S+) from (\S+)", subject)
    if m and m.group(1) not in deployed:
        deployed[m.group(1)] = (date, m.group(2))
rows = [("VERSION", "TITLE", "ALIASES", "DEPLOYED", "FROM")]
for v in json.load(sys.stdin):
    date, sha = deployed.get(v["version"], ("?", "?"))
    rows.append((v["version"], v["title"], ", ".join(v["aliases"]) or "-", date, sha))
widths = [max(len(r[i]) for r in rows) for i in range(len(rows[0]))]
for r in rows:
    print("  ".join(c.ljust(w) for c, w in zip(r, widths)).rstrip())' "$BRANCH"
}

# ./deploy delete VERSION...: shows what goes and what stays, asks, then deletes.
delete_versions() {
  (( $# )) || die "name the versions to delete, e.g. ./deploy delete 0.1 0.2 (./deploy list shows them)"
  fetch_pages
  [[ -n $BASE ]] || die "nothing is deployed yet"
  versions_json | python3 -c '
import json, sys
deployed = {v["version"]: v for v in json.load(sys.stdin)}
asked = sys.argv[1:]
for v in asked:
    if v not in deployed:
        sys.exit("error: " + v + " is not a deployed version (./deploy list shows them)")
    if deployed[v]["aliases"]:
        sys.exit("error: " + v + " is " + ", ".join(deployed[v]["aliases"]) + ": deploy or roll back to another version first")
print("Delete:", ", ".join(asked))
print("Keep:  ", ", ".join(v + (" (" + ", ".join(d["aliases"]) + ")" if d["aliases"] else "") for v, d in deployed.items() if v not in asked))' "$@"

  if (( ! DRY_RUN )); then
    [[ -t 0 ]] || die "delete asks before it deletes: run it in a terminal"
    local answer
    read -r -p "Delete these versions from ${NTRE_WIKI_URL}? [y/N] " answer
    [[ $answer == [yY] || $answer == [yY][eE][sS] ]] || die "nothing deleted"
  fi
  (
    cd wiki
    mike delete --remote "$REMOTE" --branch "$BRANCH" -m "Delete the wiki $* from the site" "$@"
  )
  check_result "^($(versions_re "$@"))/|^versions\.json$" "the delete changed files outside the deleted versions"
  [[ -z $(git diff --diff-filter=AM --name-only "$BASE" "$BRANCH" | grep -v '^versions\.json$' || true) ]] \
    || die "the delete added or changed files instead of only removing them (undo with: $RESET)"
  publish
  say "Deleted $* from ${NTRE_WIKI_URL}"
}

find_remote
case ${1:-} in
  list) list_versions ;;
  rollback) shift; rollback_to "$@" ;;
  delete) shift; delete_versions "$@" ;;
  *) deploy_version "$@" ;;
esac
